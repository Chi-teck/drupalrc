#-------------------------------------------------------------------------------
# Quick navigation between Drupal directories.
#-------------------------------------------------------------------------------
alias dcd=d-cd
function d-cd {
  if [[ $1 = "$HOME" || $1 = '-' ]]; then
    cd "$1"
    return $?
  fi

  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  # Navigate to Drupal root if no argument was provided.
  if [[ -z $1 ]]; then
    cd "$drupal_root"
    return $?
  fi

  # Target directory can be changed from the current location.
  if [[ -d "$1" ]]; then
    cd "$1"
    return $?
  fi

  # Quick search in predefined list of Drupal directories.
  for dir in $(_dcd_dirs); do
    if [[ -d $drupal_root/$dir/$1 ]]; then
      cd "$drupal_root/$dir/$1"
      return $?
    fi
  done

  # Deep search.
  local dir;
  local -r target_dirs="$drupal_root/modules $drupal_root/themes"
  # shellcheck disable=SC2086
  dir=$(find \
    $target_dirs \
    -maxdepth 3 \
    -path "*js" -prune -o \
    -path "*css" -prune -o \
    -path "*tests" -prune -o \
    -path "*templates" -prune -o \
    -path "*config" -prune -o \
    -path "*src" -prune -o \
    -path "*.git" -prune -o \
    -name "$1.info.yml"\
    -printf '%h\n')

  if [[ -n $dir ]]; then
    cd "$dir"
    return $?
  fi

  _d-error "No such directory $1."
  return 1
}

#-------------------------------------------------------------------------------
# Downloads Drupal projects.
#-------------------------------------------------------------------------------
alias dl=d-l
function d-l {
  if [[ -z $1 ]]; then
    _d-error 'Missing project name.'
    return 1;
  fi

  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  local project_root
  if ! project_root=$(_d-project "$drupal_root"); then
    return 1
  fi

  local projects=$(echo "$@" | sed 's/\</drupal\//g')
  echo 'Starting composer, this may take a while...'
  echo composer require --working-dir="$project_root" "$projects"
}

#-------------------------------------------------------------------------------
# Rebuilds Drupal caches.
#-------------------------------------------------------------------------------
alias dcr=d-cr
function d-cr {
  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  drush cache:rebuild
}

#-------------------------------------------------------------------------------
# Opens Drupal configuration files in editor.
#-------------------------------------------------------------------------------
alias dconf=d-conf
function d-conf {
  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  local file=$drupal_root/sites/default/${1-settings.php}
  if [[ ! -f $file ]]; then
    local project_root
    if ! project_root=$(_d-project "$drupal_root"); then
      _d-error "Could not locate $1 file."
      return 1
    fi
    file=$project_root/$1
    if [[ ! -f $file ]]; then
      _d-error "Could not locate $1 file."
      return 1
    fi
  fi
  ${EDITOR-nano} "$file"
  return $?
}

#-------------------------------------------------------------------------------
# Executes scripts from vendor/bin directory.
#-------------------------------------------------------------------------------
alias dbin=d-bin
function d-bin {
  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  if [[ -z $1 ]]; then
    _d-error 'Target file was not specified.'
    return 1;
  fi

  local bin_dir
  if ! bin_dir=$(_d-bin "$drupal_root"); then
    return 1;
  fi

  local file=$bin_dir/$1
  if [[ ! -x $file ]]; then
    _d-error 'No such file.'
    return 1;
  fi

  $file "${@:2}"
  return $?
}

#-------------------------------------------------------------------------------
# Executes Drush.
#-------------------------------------------------------------------------------
function drush {
  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  local file=$(_d-bin "$drupal_root")/drush
  if [[ ! -x $file ]]; then
    _d-error 'Drush is not installed on this site.'
    return 1;
  fi

  $file "$@"
  return $?
}

#-------------------------------------------------------------------------------
# Executes PHP code sniffer using Drupal standards.
#-------------------------------------------------------------------------------
alias dcs=d-cs
alias drupalcs=d-cs
function d-cs {
  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  local phpcs=$(_d-bin "$drupal_root")/phpcs
  if [[ ! -x $phpcs ]]; then
    _d-error 'PHP code sniffer is not installed.'
    return 1
  fi

  local standard
  # This only works when we are inside module directory.
  # Ideally, the configuration should also be picked when phpcs
  # is invoked from any directory (d-cs modules/example).
  if [[ -f phpcs.xml ]]; then
    standard=phpcs.xml
  else
    standard=Drupal,DrupalPractice
  fi

  # Drupal coding standards needs to be installed globally.
  $phpcs --colors -sp --standard=$standard "$@"
  return $?
}

#-------------------------------------------------------------------------------
# Runs PHPCBF tool.
#-------------------------------------------------------------------------------
alias d-cbf="d-phpcbf"
function d-phpcbf {
  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  local phpcbf=$(_d-bin "$drupal_root")/phpcbf
  if [[ ! -x $phpcbf ]]; then
    _d-error 'phpcbf is not installed.'
    return 1
  fi

  local standard
  if [[ -f phpcs.xml ]]; then
    standard=phpcs.xml
  else
    standard=Drupal,DrupalPractice
  fi

  $phpcbf --colors -sp --standard=$standard "$@"
}

#-------------------------------------------------------------------------------
# Runs PHPUnit tests.
#-------------------------------------------------------------------------------
alias d-unit="d-phpunit"
alias dunit="d-phpunit"
function d-phpunit {
  if [[ $# -eq 0 ]]; then
    _d-error 'Missing path.'
    return 1;
  fi

  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  local file=$(_d-bin "$drupal_root")/phpunit
  if [[ ! -f $file ]]; then
    _d-error 'PHPUnit is not installed.'
    return 1
  fi

  "$file" -c "$drupal_root"/core "$@"
}

#-------------------------------------------------------------------------------
# Runs PHPStan analyze.
#-------------------------------------------------------------------------------
alias d-stan="d-phpstan"
alias dstan="d-phpstan"
function d-phpstan {
  local path=${1:-$(pwd)}

  local drupal_root
  if ! drupal_root=$(_d-root "$path"); then
    return 1;
  fi

  local phpstan=$(_d-bin "$drupal_root")/phpstan
  if [[ ! -f $phpstan ]]; then
    _d-error 'PHPStan is not installed.'
    return 1
  fi

  local configuration
  if [[ -f phpstan.neon ]]; then
    configuration="--configuration=phpstan.neon"
  fi

  "$phpstan" analyze "$configuration" "$@"
}

#-------------------------------------------------------------------------------
# Prints a path to Drupal root directory.
#
# @internal
#-------------------------------------------------------------------------------
function _d-root {
  : "${1?${FUNCNAME[0]} - missing parameter}"

  local dir=$(readlink -f "$1");
  while true; do
    if [[ $dir == '/' ]]; then
      _d-error 'Drupal installation was not found.'
      return 1;
    fi
    # Check if Drupal resides in the current directory on in a sibling directory.
    for sibling in . www docroot web htdocs public public_html html; do
      if _d-version "$dir/$sibling" drupal_version; then
        if [[ $drupal_version -ge 8 ]]; then
          echo "$dir/$sibling"
          return 0
        else
          _d-error "Drupal $drupal_version is not supported."
          return 1;
        fi
      fi
    done
    dir=$(dirname "$dir")
  done
}

#-------------------------------------------------------------------------------
# Prints Drupal major version.
#
# @param 1
#   Path to Drupal root directory.
# @param 2
#   Variable to store Drupal version
#
# @internal
#-------------------------------------------------------------------------------
function _d-version {
  : "${1?${FUNCNAME[0]} - missing parameter}"
  local -n _d_version=$2
  if [[ -f $1/index.php && -f $1/core/lib/Drupal.php ]]; then
   _d_version=$(grep -oP "(?<=VERSION = ')[0-9]+(?=\.)" "$1"/core/lib/Drupal.php)
  elif [[ -f $1/index.php && -d $1/includes/database ]]; then
    _d_version=7
  elif [[ -f $1/index.php && -f $1/includes/database.inc ]]; then
    _d_version=6
  else
    return 1
  fi
}

#-------------------------------------------------------------------------------
# Prints path to project root directory.
#
# @param 1
#   Path to Drupal root directory.
#
# @internal
#-------------------------------------------------------------------------------
function _d-project {
  : "${1?${FUNCNAME[0]} - missing parameter}"
  if [[ -f $1/../composer.json ]]; then
    echo "$1"/..
  elif [[ -f $1/composer.json ]]; then
    echo "$1"
  else
    _d-error 'Could not find composer.json file.'
    return 1
  fi
}

#-------------------------------------------------------------------------------
# Prints error message.
#
# @internal
#-------------------------------------------------------------------------------
function _d-error {
  echo -e "\e[38;5;205m$*\e[0m" >&2
}

#-------------------------------------------------------------------------------
# Prints common Drupal directories to navigate.
#
# @internal
#-------------------------------------------------------------------------------
function _dcd_dirs {
  echo '. .. sites sites/all sites/default default modules themes modules/contrib modules/custom core/modules core/themes'
}

#-------------------------------------------------------------------------------
# Prints a path to bin directory.
#
# @param 1
#   Path to Drupal root directory.
#
# @internal
#-------------------------------------------------------------------------------
function _d-bin {
  : "${1?${FUNCNAME[0]} - missing parameter}"
  local project_root
  if ! project_root=$(_d-project "$1"); then
    return 1
  fi
  # Technically the bin directory can be everywhere. However, the vast majority
  # projects use default location.
  # @see `composer config vendor-bin`
  if [[ -d "$project_root"/vendor/bin ]]; then
    echo "$project_root"/vendor/bin
  elif [[ -d "$project_root"/bin ]]; then
    echo "$project_root"/bin
  else
    _d-error 'bin directory was not found.'
    return 1
  fi
}
